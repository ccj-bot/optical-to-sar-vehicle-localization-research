    "domain": {"enum": ["CAR","PERSON"]},
    "identity_status": {"enum": ["CLEAR","LIKELY","AMBIGUOUS","REJECT"]},
    "body_completeness": {"enum": ["COMPLETE","MOSTLY_COMPLETE","PARTIAL","UNKNOWN"]},
    "boundary_state": {"enum": ["INTERIOR","EDGE_PARTIAL","TRUNCATED","UNKNOWN"]},
